# ============================================================
# Intelligens Számlafeldolgozó – Környezeti változók sablonja
# Másold le .env névvel és töltsd ki az értékeket.
# SOHA ne commitold a .env fájlt a git repóba!
# ============================================================

# --- Google Cloud Platform ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=eu                         # Document AI processzor régiója – Console-ban látszik (us vagy eu)

# Document AI Invoice Parser processor ID
# GCP Console → Document AI → Create Processor → Invoice Parser
GCP_PROCESSOR_ID=your-processor-id

# --- Gemini (Vertex AI + ADC – nincs API kulcs szükséges) ---
# Helyi fejlesztés: gcloud auth application-default login
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_LOCATION=global

# --- Fájlkezelési beállítások ---
MAX_FILE_SIZE_MB=20                      # Maximális fájlméret MB-ban
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png      # Engedélyezett fájltípusok (vesszővel elválasztva)
MAX_FILES_PER_BATCH=10                   # Maximum fájlok száma egy batch-ben
UPLOAD_DIR=/tmp/invoices                 # Ideiglenes fájltároló könyvtár

# --- Document AI batch (opcionális – rate limit / 500 hiba csökkentés) ---
BATCH_FILE_DELAY_SECONDS=5               # Min. szünet minden DocAI hívás között (mp)
BATCH_RETRY_DELAY_SECONDS=12             # Szünet az automatikus újrapróba kör előtt (mp)
DOCAI_RETRY_BASE_SECONDS=2               # Document AI újrapróbálás alap várakozás (mp)
DOCAI_MAX_RETRIES=5

# --- Backend szerver ---
# Helyi indítás: ./dev.sh (host/port a scriptben). Cloud Run: PORT env automatikus.
CORS_ORIGINS=http://localhost:3000       # Frontend URL(ek) – vesszővel elválasztva
